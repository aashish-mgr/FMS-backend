generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(255)
  slug        String       @unique @db.VarChar(100)
  status      TenantStatus @default(TRIAL)
  plan        String       @default("free") @db.VarChar(50)
  trialEndsAt DateTime?    @db.Timestamptz(6)
  settings    Json?        @db.JsonB
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?    @db.Timestamptz(6)

  users             User[]
  incomeCategories  IncomeCategory[]
  expenseCategories ExpenseCategory[]
  incomes           Income[]
  expenses          Expense[]
  notes             Note[]
  remainders        Remainder[]
  auditLogs         AuditLogs[]
  attachments       Attachment[]
  invitations       WorkspaceInvitation[]

  @@map("tenants")
}

model User {
  id                                 String                @id @default(uuid()) @db.Uuid
  tenantId                           String                @db.Uuid
  userName                           String                @db.VarChar(255)
  userEmail                          String                @unique @db.VarChar(255)
  userPassword                       String                @db.VarChar(255)
  createdAt                          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt                          DateTime?             @db.Timestamptz(6)
  tenant                             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses_expenses_createdByTousers Expense[]             @relation("expenses_createdByTousers")
  expenses_expenses_updatedByTousers Expense[]             @relation("expenses_updatedByTousers")
  incomes_incomes_createdByTousers   Income[]              @relation("incomes_createdByTousers")
  incomes_incomes_updatedByTousers   Income[]              @relation("incomes_updatedByTousers")
  notes                              Note[]
  remainders                         Remainder[]
  userRoles                          UserRole[]
  attachments                        Attachment[]
  sentInvitations                    WorkspaceInvitation[] @relation("InvitationInvitedBy")

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String                @id @default(uuid()) @db.Uuid
  roleName    String                @db.VarChar(255)
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(6)
  userRoles   UserRole[]
  invitations WorkspaceInvitation[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  roles     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("userRoles")
}

model IncomeCategory {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  categoryName        String    @db.VarChar(255)
  categoryDescription String    @db.VarChar(255)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime? @db.Timestamptz(6)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incomes             Income[]

  @@unique([tenantId, categoryName])
  @@index([tenantId, deletedAt])
  @@map("incomeCategories")
}

model ExpenseCategory {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  categoryName        String    @db.VarChar(255)
  categoryDescription String    @db.VarChar(255)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime? @db.Timestamptz(6)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses            Expense[]

  @@unique([tenantId, categoryName])
  @@index([tenantId, deletedAt])
  @@map("expenseCategories")
}

model Income {
  id                             String         @id @default(uuid()) @db.Uuid
  tenantId                       String         @db.Uuid
  transactionDate                DateTime       @db.Timestamptz(6)
  amount                         Decimal        @db.Decimal(15, 2)
  incomeCategoryId               String         @db.Uuid
  incomeSource                   String?        @db.VarChar(255)
  clientName                     String?        @db.VarChar(255)
  paymentMethod                  String         @db.VarChar(255)
  referenceNumber                String?        @db.VarChar(255)
  invoiceNumber                  String?        @db.VarChar(255)
  description                    String?        @db.VarChar(255)
  createdBy                      String?        @db.Uuid
  updatedBy                      String?        @db.Uuid
  createdAt                      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt                      DateTime?      @db.Timestamptz(6)
  tenant                         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users_incomes_createdByTousers User?          @relation("incomes_createdByTousers", fields: [createdBy], references: [id], onDelete: Cascade)
  incomeCategories               IncomeCategory @relation(fields: [incomeCategoryId], references: [id], onDelete: Cascade)
  users_incomes_updatedByTousers User?          @relation("incomes_updatedByTousers", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@index([tenantId, transactionDate])
  @@map("incomes")
}

model Expense {
  id                              String          @id @default(uuid()) @db.Uuid
  tenantId                        String          @db.Uuid
  transactionDate                 DateTime        @db.Timestamptz(6)
  amount                          Decimal         @db.Decimal(15, 2)
  expenseCategoryId               String          @db.Uuid
  vendorName                      String?         @db.VarChar(255)
  paymentMethod                   String          @db.VarChar(255)
  billNumber                      String?         @db.VarChar(255)
  description                     String?         @db.VarChar(255)
  createdBy                       String?         @db.Uuid
  updatedBy                       String?         @db.Uuid
  createdAt                       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt                       DateTime?       @db.Timestamptz(6)
  tenant                          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users_expenses_createdByTousers User?           @relation("expenses_createdByTousers", fields: [createdBy], references: [id], onDelete: Cascade)
  expenseCategories               ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  users_expenses_updatedByTousers User?           @relation("expenses_updatedByTousers", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@index([tenantId, transactionDate])
  @@map("expenses")
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  title       String    @db.VarChar(255)
  description String    @db.VarChar(255)
  colorLabel  String?   @db.VarChar(255)
  isPinned    Boolean?  @default(false)
  isArchived  Boolean?  @default(false)
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User?     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@map("notes")
}

model Remainder {
  id            String                   @id @default(uuid()) @db.Uuid
  tenantId      String                   @db.Uuid
  title         String                   @db.VarChar(255)
  description   String?                  @db.VarChar(255)
  remainderDate DateTime                 @db.Timestamptz(6)
  remainderTime DateTime?                @db.Time(6)
  priority      enum_remainders_priority
  status        enum_remainders_status   @default(PENDING)
  repeat        enum_remainders_repeat?  @default(NONE)
  createdBy     String?                  @db.Uuid
  createdAt     DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?                @db.Timestamptz(6)
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         User?                    @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@map("remainders")
}

model AuditLogs {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String?  @db.Uuid
  oldValues  Json?    @db.JsonB
  newValues  Json?    @db.JsonB
  ipAddress  String?  @db.Inet
  createdAt  DateTime @default(now()) @db.Timestamptz()
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("auditlogs")
}

model Attachment {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  entityType String    @db.VarChar(50)
  entityId   String    @db.Uuid
  fileName   String    @db.VarChar(255)
  fileSize   Int // bytes; Int is fine up to ~2GB, well above the 10MB cap
  mimeType   String    @db.VarChar(100)
  storageKey String    @db.VarChar(500)
  storageUrl String    @db.Text
  provider   String    @db.VarChar(50)
  uploadedBy String    @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader   User      @relation(fields: [uploadedBy], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, deletedAt])
  @@index([deletedAt])
  @@map("attachments")
}

model WorkspaceInvitation {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  email      String           @db.VarChar(255)
  roleId     String           @db.Uuid
  invitedBy  String?          @db.Uuid
  tokenHash  String           @unique @db.VarChar(255)
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @db.Timestamptz(6)
  acceptedAt DateTime?        @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  inviter    User?            @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@index([roleId])
  @@index([invitedBy])
  @@map("workspaceInvitations")
}

enum enum_remainders_priority {
  LOW
  MEDIUM
  HIGH
}

enum enum_remainders_repeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum enum_remainders_status {
  PENDING
  COMPLETED
}
