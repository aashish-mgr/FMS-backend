# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
JWT_SECRET="replace-with-a-long-random-secret"
MAX_ATTACHMENT_SIZE_MB=10

# Public frontend origin. Used for invitation accept links and CORS.
FRONTEND_URL="http://localhost:5173"

# Optional SMTP delivery for invitation, password reset, and verification
# emails. Leave SMTP_HOST empty to keep the API usable without email delivery.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FMS <no-reply@example.com>"

# Storage. Use "cloudinary" in production and "local" only for local
# development. Cloudinary credentials are required when the provider is
# "cloudinary"; startup fails if they are missing.
STORAGE_PROVIDER=cloudinary
LOCAL_UPLOAD_PATH="./uploads"
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=fms
